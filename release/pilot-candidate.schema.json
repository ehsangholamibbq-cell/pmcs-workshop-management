{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmcs.invalid/schemas/pilot-candidate-v1.json",
  "title": "PMCS Pilot Release Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "version", "commit", "builtAt", "createdAt", "expiresAt", "artifacts", "evidence", "approvals"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "type": "string", "pattern": "^pmcs-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-rc\\.[0-9]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "commit": { "$ref": "#/$defs/commit" },
    "builtAt": { "$ref": "#/$defs/timestamp" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "$ref": "#/$defs/timestamp" },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "enum": ["api-image", "web-image", "source-bundle"] },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateId", "status", "commit", "executedAt", "expiresAt", "reportSha256", "reportUri"],
        "properties": {
          "gateId": { "type": "string" },
          "status": { "const": "passed" },
          "commit": { "$ref": "#/$defs/commit" },
          "executedAt": { "$ref": "#/$defs/timestamp" },
          "expiresAt": { "$ref": "#/$defs/timestamp" },
          "reportSha256": { "$ref": "#/$defs/sha256" },
          "reportUri": { "type": "string", "pattern": "^evidence://[A-Za-z0-9._/-]+$" }
        }
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "decision", "approvedBy", "approvedAt", "commit"],
        "properties": {
          "role": { "enum": ["product", "security", "operations"] },
          "decision": { "const": "approved" },
          "approvedBy": { "type": "string", "minLength": 3, "maxLength": 200 },
          "approvedAt": { "$ref": "#/$defs/timestamp" },
          "commit": { "$ref": "#/$defs/commit" }
        }
      }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
